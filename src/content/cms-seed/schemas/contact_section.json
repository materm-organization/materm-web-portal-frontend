{
  "key": "contact_section",
  "version": 1,
  "name": "Contact section",
  "description": "Heading + contact info rows (values from site_settings group contact) on the left, form panel on the right.",
  "variants": [],
  "allowed_scopes": [
    "page",
    "shared"
  ],
  "is_current": true,
  "is_active": true,
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://materm.example/schemas/sections/contact_section/v1.json",
    "title": "Contact section",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "eyebrow",
      "title"
    ],
    "properties": {
      "eyebrow": {
        "title": "Eyebrow",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 32
        },
        "description": "Tick eyebrow label (SectionHeading variant=tick); rendered uppercase, no wrap."
      },
      "title": {
        "title": "Title",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 120
        },
        "description": "h2"
      },
      "description": {
        "title": "Description",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 400
        },
        "x-multiline": true,
        "description": "Lead paragraph under the title"
      },
      "info_items": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "icon",
            "label",
            "source"
          ],
          "properties": {
            "icon": {
              "enum": [
                "map_pin",
                "phone",
                "mail",
                "clock"
              ],
              "description": "Icon registry in code (lucide)."
            },
            "label": {
              "title": "Label",
              "x-localized": true,
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 40
              }
            },
            "source": {
              "enum": [
                "contact.address",
                "contact.phone",
                "contact.email",
                "contact.hours",
                "custom"
              ],
              "description": "contact.phone -> text phone_display, href tel:+phone (E.164); contact.email -> mailto:; contact.address -> optional href contact.map_url."
            },
            "value": {
              "title": "Custom value (source=custom)",
              "x-localized": true,
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 200
              },
              "x-multiline": true
            },
            "link": {
              "$ref": "#/$defs/link",
              "title": "Custom link (source=custom)"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "custom"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            }
          ]
        }
      },
      "form_slug": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,59}$",
        "x-ref": "forms_forms",
        "description": "forms_forms.slug of a published form; empty = no form panel."
      }
    },
    "$defs": {
      "locale_text_short": {
        "description": "Localized single-line text: {locale_code: string}. Partial maps are allowed in drafts; the default locale is checked at publish (BR-13).",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 250
        }
      },
      "richtext_lite_doc": {
        "description": "Tiptap/ProseMirror doc, 'lite' profile (paragraph, bulletList, orderedList, listItem, hardBreak, text + marks bold/italic/link). Deep node check is done in Go (x-richtext).",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "doc"
          },
          "content": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          }
        }
      },
      "locale_richtext_lite": {
        "description": "Localized rich text (lite profile): {locale_code: doc}.",
        "x-localized": true,
        "x-richtext": "lite",
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/richtext_lite_doc"
        }
      },
      "image": {
        "description": "Image placement. media_id -> media_assets.id (indexed by media_usages via trigger trg_usages). alt = per-placement override; empty/missing -> media_asset_translations.alt. decorative=true renders alt=\"\".",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_id"
        ],
        "properties": {
          "media_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "media_assets"
          },
          "alt": {
            "$ref": "#/$defs/locale_text_short"
          },
          "decorative": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "link": {
        "description": "Internal page reference (survives path changes) or external/mailto/tel URL. Same vocabulary as cms_menu_items.link_type. Discriminated by `type` (if/then) so that a half-filled link reports `required` at the missing field.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "page",
              "url"
            ]
          },
          "page_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "cms_pages"
          },
          "anchor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(https://|/|mailto:|tel:|#)"
          },
          "open_in_new_tab": {
            "type": "boolean",
            "default": false
          },
          "rel": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "enum": [
                "nofollow",
                "sponsored",
                "ugc"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "page"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "page_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "url"
                    ]
                  },
                  {
                    "required": [
                      "open_in_new_tab"
                    ]
                  },
                  {
                    "required": [
                      "rel"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "url"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "url"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "page_id"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "cta": {
        "description": "Call to action button (CtaLink).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "link"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/locale_text_short"
          },
          "link": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  },
  "ui_schema": {
    "ui:order": [
      "eyebrow",
      "title",
      "description",
      "info_items",
      "form_slug"
    ],
    "description": {
      "ui:widget": "textarea"
    },
    "info_items": {
      "ui:options": {
        "orderable": true
      },
      "items": {
        "value": {
          "ui:showIf": {
            "source": "custom"
          }
        },
        "link": {
          "ui:showIf": {
            "source": "custom"
          }
        }
      }
    },
    "form_slug": {
      "ui:widget": "form-picker"
    }
  },
  "default_props": {
    "eyebrow": {},
    "title": {},
    "info_items": [],
    "form_slug": "contact"
  },
  "props_migrations": []
}
