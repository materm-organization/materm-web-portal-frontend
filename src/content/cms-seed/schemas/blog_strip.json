{
  "key": "blog_strip",
  "version": 1,
  "name": "Blog strip",
  "description": "Home blog strip: heading + 3-4 hover-expanding post slices + CTA. Slice data (label, title, date, excerpt, image) comes from published posts; manual items may override the image/excerpt per slice.",
  "variants": [],
  "allowed_scopes": [
    "page",
    "shared"
  ],
  "is_current": true,
  "is_active": true,
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://materm.example/schemas/sections/blog_strip/v1.json",
    "title": "Blog strip",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "eyebrow",
      "title",
      "source"
    ],
    "properties": {
      "eyebrow": {
        "title": "Eyebrow",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 32
        }
      },
      "title": {
        "title": "Title",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 120
        }
      },
      "description": {
        "title": "Description",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 400
        },
        "x-multiline": true
      },
      "cta": {
        "$ref": "#/$defs/cta",
        "title": "Button"
      },
      "source": {
        "title": "Source",
        "enum": [
          "latest",
          "manual"
        ],
        "default": "latest"
      },
      "limit": {
        "title": "Number of slices (latest)",
        "type": "integer",
        "minimum": 3,
        "maximum": 4,
        "default": 4
      },
      "category_id": {
        "title": "Only this category (latest)",
        "type": "integer",
        "minimum": 1,
        "x-ref": "cms_categories"
      },
      "items": {
        "title": "Slices (manual)",
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "post_id"
          ],
          "properties": {
            "post_id": {
              "type": "integer",
              "minimum": 1,
              "x-ref": "cms_posts"
            },
            "image": {
              "$ref": "#/$defs/image",
              "title": "Image override",
              "description": "Empty -> posts.teaser_media_id, then hero_media_id"
            },
            "excerpt": {
              "title": "Excerpt override",
              "x-localized": true,
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 300
              },
              "x-multiline": true,
              "description": "Empty -> post_translations.excerpt"
            }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "source": {
              "const": "manual"
            }
          },
          "required": [
            "source"
          ]
        },
        "then": {
          "required": [
            "items"
          ]
        }
      }
    ],
    "$defs": {
      "locale_text_short": {
        "description": "Localized single-line text: {locale_code: string}. Partial maps are allowed in drafts; the default locale is checked at publish (BR-13).",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 250
        }
      },
      "richtext_lite_doc": {
        "description": "Tiptap/ProseMirror doc, 'lite' profile (paragraph, bulletList, orderedList, listItem, hardBreak, text + marks bold/italic/link). Deep node check is done in Go (x-richtext).",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "doc"
          },
          "content": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          }
        }
      },
      "locale_richtext_lite": {
        "description": "Localized rich text (lite profile): {locale_code: doc}.",
        "x-localized": true,
        "x-richtext": "lite",
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/richtext_lite_doc"
        }
      },
      "image": {
        "description": "Image placement. media_id -> media_assets.id (indexed by media_usages via trigger trg_usages). alt = per-placement override; empty/missing -> media_asset_translations.alt. decorative=true renders alt=\"\".",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_id"
        ],
        "properties": {
          "media_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "media_assets"
          },
          "alt": {
            "$ref": "#/$defs/locale_text_short"
          },
          "decorative": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "link": {
        "description": "Internal page reference (survives path changes) or external/mailto/tel URL. Same vocabulary as cms_menu_items.link_type. Discriminated by `type` (if/then) so that a half-filled link reports `required` at the missing field.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "page",
              "url"
            ]
          },
          "page_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "cms_pages"
          },
          "anchor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(https://|/|mailto:|tel:|#)"
          },
          "open_in_new_tab": {
            "type": "boolean",
            "default": false
          },
          "rel": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "enum": [
                "nofollow",
                "sponsored",
                "ugc"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "page"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "page_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "url"
                    ]
                  },
                  {
                    "required": [
                      "open_in_new_tab"
                    ]
                  },
                  {
                    "required": [
                      "rel"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "url"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "url"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "page_id"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "cta": {
        "description": "Call to action button (CtaLink).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "link"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/locale_text_short"
          },
          "link": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  },
  "ui_schema": {
    "ui:order": [
      "eyebrow",
      "title",
      "description",
      "cta",
      "source",
      "limit",
      "category_id",
      "items"
    ],
    "description": {
      "ui:widget": "textarea"
    },
    "category_id": {
      "ui:widget": "category-picker",
      "ui:showIf": {
        "source": "latest"
      }
    },
    "limit": {
      "ui:showIf": {
        "source": "latest"
      }
    },
    "items": {
      "ui:showIf": {
        "source": "manual"
      },
      "ui:options": {
        "orderable": true
      },
      "items": {
        "post_id": {
          "ui:widget": "post-picker"
        },
        "image": {
          "ui:widget": "media-picker"
        },
        "excerpt": {
          "ui:widget": "textarea"
        }
      }
    }
  },
  "default_props": {
    "eyebrow": {},
    "title": {},
    "source": "latest",
    "limit": 4
  },
  "props_migrations": []
}
