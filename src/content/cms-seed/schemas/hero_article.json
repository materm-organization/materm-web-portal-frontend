{
  "key": "hero_article",
  "version": 1,
  "name": "Hero (article)",
  "description": "Full-bleed hero with bottom-left h1 and a meta row (PageHero variant=article). Used by Blog index and Gallery; the blog article hero is rendered from the post (not a section).",
  "variants": [],
  "allowed_scopes": [
    "page",
    "shared"
  ],
  "is_current": true,
  "is_active": true,
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://materm.example/schemas/sections/hero_article/v1.json",
    "title": "Hero (article)",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "background"
    ],
    "properties": {
      "title": {
        "title": "Title (h1)",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 120
        }
      },
      "meta_items": {
        "title": "Meta row",
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "title": "Text",
              "x-localized": true,
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 60
              }
            }
          }
        }
      },
      "background": {
        "$ref": "#/$defs/image",
        "title": "Background photo"
      },
      "animate_in": {
        "type": "boolean",
        "default": true
      }
    },
    "$defs": {
      "locale_text_short": {
        "description": "Localized single-line text: {locale_code: string}. Partial maps are allowed in drafts; the default locale is checked at publish (BR-13).",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 250
        }
      },
      "richtext_lite_doc": {
        "description": "Tiptap/ProseMirror doc, 'lite' profile (paragraph, bulletList, orderedList, listItem, hardBreak, text + marks bold/italic/link). Deep node check is done in Go (x-richtext).",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "doc"
          },
          "content": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          }
        }
      },
      "locale_richtext_lite": {
        "description": "Localized rich text (lite profile): {locale_code: doc}.",
        "x-localized": true,
        "x-richtext": "lite",
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/richtext_lite_doc"
        }
      },
      "image": {
        "description": "Image placement. media_id -> media_assets.id (indexed by media_usages via trigger trg_usages). alt = per-placement override; empty/missing -> media_asset_translations.alt. decorative=true renders alt=\"\".",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_id"
        ],
        "properties": {
          "media_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "media_assets"
          },
          "alt": {
            "$ref": "#/$defs/locale_text_short"
          },
          "decorative": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "link": {
        "description": "Internal page reference (survives path changes) or external/mailto/tel URL. Same vocabulary as cms_menu_items.link_type. Discriminated by `type` (if/then) so that a half-filled link reports `required` at the missing field.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "page",
              "url"
            ]
          },
          "page_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "cms_pages"
          },
          "anchor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(https://|/|mailto:|tel:|#)"
          },
          "open_in_new_tab": {
            "type": "boolean",
            "default": false
          },
          "rel": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "enum": [
                "nofollow",
                "sponsored",
                "ugc"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "page"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "page_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "url"
                    ]
                  },
                  {
                    "required": [
                      "open_in_new_tab"
                    ]
                  },
                  {
                    "required": [
                      "rel"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "url"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "url"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "page_id"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "cta": {
        "description": "Call to action button (CtaLink).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "link"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/locale_text_short"
          },
          "link": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  },
  "ui_schema": {
    "ui:order": [
      "title",
      "meta_items",
      "background",
      "animate_in"
    ],
    "background": {
      "ui:widget": "media-picker",
      "ui:options": {
        "ratio": "hero"
      }
    },
    "meta_items": {
      "ui:options": {
        "orderable": true
      }
    }
  },
  "default_props": {
    "title": {},
    "meta_items": [],
    "animate_in": true
  },
  "props_migrations": []
}
