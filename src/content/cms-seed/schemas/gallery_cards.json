{
  "key": "gallery_cards",
  "version": 1,
  "name": "Gallery cards",
  "description": "Heading + row of tall rounded photo cards (GalleryCard 430x562) + optional CTA. Variant = frame: home (Home teaser), standard (Our Path teaser), showcase (Gallery page, no links/caption/CTA in the design).",
  "variants": [
    "home",
    "standard",
    "showcase"
  ],
  "allowed_scopes": [
    "page",
    "shared"
  ],
  "is_current": true,
  "is_active": true,
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://materm.example/schemas/sections/gallery_cards/v1.json",
    "title": "Gallery cards",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "eyebrow",
      "title",
      "source"
    ],
    "properties": {
      "eyebrow": {
        "title": "Eyebrow",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 32
        }
      },
      "title": {
        "title": "Title",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 120
        }
      },
      "description": {
        "title": "Description",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 400
        },
        "x-multiline": true
      },
      "cta": {
        "$ref": "#/$defs/cta",
        "title": "Button"
      },
      "row_label": {
        "title": "Accessible name of the card row",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 80
        },
        "description": "Empty -> ui_strings site.gallery.rowLabel"
      },
      "source": {
        "enum": [
          "manual",
          "album"
        ],
        "default": "manual"
      },
      "album_id": {
        "type": "integer",
        "minimum": 1,
        "x-ref": "cms_albums"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9,
        "default": 3
      },
      "cards_link": {
        "$ref": "#/$defs/link",
        "title": "Link for every card",
        "description": "Used when a card has no own link, and for every card when source=album"
      },
      "cards": {
        "title": "Cards (manual)",
        "type": "array",
        "minItems": 1,
        "maxItems": 9,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "$ref": "#/$defs/image"
            },
            "caption": {
              "type": "object",
              "additionalProperties": false,
              "description": "Hover caption (green tick + date, bold title). Omit = no caption.",
              "properties": {
                "date": {
                  "title": "Caption date (free text)",
                  "x-localized": true,
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 24
                  }
                },
                "title": {
                  "title": "Caption title",
                  "x-localized": true,
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              }
            },
            "link": {
              "$ref": "#/$defs/link"
            }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "source": {
              "const": "album"
            }
          },
          "required": [
            "source"
          ]
        },
        "then": {
          "required": [
            "album_id"
          ]
        },
        "else": {
          "required": [
            "cards"
          ]
        }
      }
    ],
    "$defs": {
      "locale_text_short": {
        "description": "Localized single-line text: {locale_code: string}. Partial maps are allowed in drafts; the default locale is checked at publish (BR-13).",
        "x-localized": true,
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 250
        }
      },
      "richtext_lite_doc": {
        "description": "Tiptap/ProseMirror doc, 'lite' profile (paragraph, bulletList, orderedList, listItem, hardBreak, text + marks bold/italic/link). Deep node check is done in Go (x-richtext).",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "doc"
          },
          "content": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          }
        }
      },
      "locale_richtext_lite": {
        "description": "Localized rich text (lite profile): {locale_code: doc}.",
        "x-localized": true,
        "x-richtext": "lite",
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/richtext_lite_doc"
        }
      },
      "image": {
        "description": "Image placement. media_id -> media_assets.id (indexed by media_usages via trigger trg_usages). alt = per-placement override; empty/missing -> media_asset_translations.alt. decorative=true renders alt=\"\".",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_id"
        ],
        "properties": {
          "media_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "media_assets"
          },
          "alt": {
            "$ref": "#/$defs/locale_text_short"
          },
          "decorative": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "link": {
        "description": "Internal page reference (survives path changes) or external/mailto/tel URL. Same vocabulary as cms_menu_items.link_type. Discriminated by `type` (if/then) so that a half-filled link reports `required` at the missing field.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "page",
              "url"
            ]
          },
          "page_id": {
            "type": "integer",
            "minimum": 1,
            "x-ref": "cms_pages"
          },
          "anchor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(https://|/|mailto:|tel:|#)"
          },
          "open_in_new_tab": {
            "type": "boolean",
            "default": false
          },
          "rel": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "enum": [
                "nofollow",
                "sponsored",
                "ugc"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "page"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "page_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "url"
                    ]
                  },
                  {
                    "required": [
                      "open_in_new_tab"
                    ]
                  },
                  {
                    "required": [
                      "rel"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "url"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "url"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "page_id"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "cta": {
        "description": "Call to action button (CtaLink).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "link"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/locale_text_short"
          },
          "link": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  },
  "ui_schema": {
    "ui:order": [
      "eyebrow",
      "title",
      "description",
      "cta",
      "row_label",
      "source",
      "album_id",
      "limit",
      "cards_link",
      "cards"
    ],
    "description": {
      "ui:widget": "textarea"
    },
    "album_id": {
      "ui:widget": "album-picker",
      "ui:showIf": {
        "source": "album"
      }
    },
    "limit": {
      "ui:showIf": {
        "source": "album"
      }
    },
    "cards": {
      "ui:showIf": {
        "source": "manual"
      },
      "ui:options": {
        "orderable": true
      },
      "items": {
        "image": {
          "ui:widget": "media-picker",
          "ui:options": {
            "ratio": "430:562"
          }
        },
        "link": {
          "ui:widget": "link-picker"
        }
      }
    },
    "ui:variant": {
      "home": "Home teaser",
      "standard": "Standard teaser",
      "showcase": "Showcase (no links)"
    }
  },
  "default_props": {
    "eyebrow": {},
    "title": {},
    "source": "manual"
  },
  "props_migrations": []
}
