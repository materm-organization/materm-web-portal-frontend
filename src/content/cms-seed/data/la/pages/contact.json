        "resolved": {
          "items": [
            {
              "id": 1,
              "question": "ເດີນທາງໄປ Materm ແນວໃດ?",
              "answer": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Materm ຕັ້ງຢູ່ໃນອຸທະຍານແຫ່ງຊາດພູເຂົາຂ່ວຍ ແຂວງວຽງຈັນ. ສົ່ງຂໍ້ຄວາມຫາພວກເຮົາ, ພວກເຮົາຈະສົ່ງເສັ້ນທາງໃຫ້ ແລະ ຊ່ວຍທ່ານວາງແຜນການເດີນທາງ."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": 2,
              "question": "ເວລາເຂົ້າພັກ ແລະ ເວລາເປີດບໍລິການແມ່ນຕອນໃດ?",
              "answer": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "ພວກເຮົາເປີດທຸກວັນ ຕັ້ງແຕ່ 08:00 ຫາ 18:00. ເວລາເຂົ້າພັກ ແລະ ເວລາອອກຈາກທີ່ພັກຂຶ້ນກັບການພັກຂອງທ່ານ, ພວກເຮົາຈະຢືນຢັນໃຫ້ເມື່ອທ່ານຈອງ."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": 3,
              "question": "ມີຄືນດົນຕີ ແລະ ງານຕ່າງໆບໍ?",
              "answer": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "ມີ, ພວກເຮົາຈັດຄືນດົນຕີ ແລະ ການພົບປະສັງສັນນ້ອຍໆເປັນບາງຄັ້ງຄາວ. ສອບຖາມວັນທີທີ່ຈະມາເຖິງກ່ອນວາງແຜນມາຢ້ຽມຢາມ."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": 4,
              "question": "ຈັດໃຫ້ກຸ່ມ ຫຼື ຄຳຮ້ອງຂໍພິເສດໄດ້ບໍ?",
              "answer": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "ພວກເຮົາຍິນດີຊ່ວຍເຫຼືອກຸ່ມ, ງານສະຫຼອງ ແລະ ຄວາມຕ້ອງການພິເສດ. ບອກພວກເຮົາວ່າທ່ານຄິດຢາກໄດ້ແນວໃດ, ພວກເຮົາຈະຊອກວິທີທີ່ເຮັດໄດ້."
                      }
                    ]
                  }
                ]
              }
            }
          ]
