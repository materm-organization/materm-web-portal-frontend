# Ignore node_modules and build outputs
node_modules
.next
out
.vscode

# Ignore dev and config files
Dockerfile
docker-compose.*
.dockerignore
*.log
*.tsbuildinfo

# Ignore local-only env overrides (the committed .env.development /
# .env.production ARE needed inside the build context — see Dockerfile)
.env.local
.env.test
.env*.local

# Ignore version control and IDE config
.git
.gitignore
.vscode
.idea
