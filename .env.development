# Placeholder backend URL — point this at wherever your real dev backend
# runs. `:8080` avoids colliding with the Next.js dev server itself, which
# defaults to `:3000`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# TEMPORARY: skip the auth guard + current-user API call so /admin renders
# without a running backend or a real login. Dev-only — never set this in
# .env.production. Remove once real login is wired up end-to-end (see
# hooks/use-auth.ts's DEV_BYPASS_AUTH).
NEXT_PUBLIC_DISABLE_AUTH_GUARD=true
