{
  "name": "materm-web-portal-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:shadows": "node scripts/check-no-shadows.mjs",
    "check:i18n": "node scripts/i18n/check-parity.mjs",
    "cms:export": "node scripts/cms/export-media-manifest.mjs && node scripts/cms/export-ui-strings.mjs && node scripts/cms/build-seed.mjs",
    "cms:check": "node scripts/cms/export-media-manifest.mjs --check && node scripts/cms/export-ui-strings.mjs --check && node scripts/cms/build-seed.mjs --check && node scripts/cms/validate-seed.mjs",
    "cms:check:strict": "node scripts/cms/export-ui-strings.mjs --strict --check && npm run cms:check",
    "cms:validate": "node scripts/cms/validate-seed.mjs",
    "cms:mock": "node scripts/cms/mock-api.mjs",
    "cms:selftest": "node scripts/cms/selftest.mjs",
    "cms:sync-doc": "node scripts/cms/sync-from-doc.mjs",
    "site:selftest": "node scripts/site/selftest.mjs",
    "revalidate:demo": "node scripts/cms/revalidate-demo.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.48.0",
    "motion": "^14.4.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
